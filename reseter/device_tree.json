{
  "$schema": "../../libraries/JaszczurHAL/config/hardware/device_tree.schema.json",
  "schemaVersion": 1,
  "nodes": {
    "routerRelay": {
      "compatible": "jaszczurhal,gpio-output"
    }
  },
  "assemblies": {
    "picow": {
      "target": "rp2040",
      "board": "picow",
      "clock": {
        "tree": "default"
      },
      "statusLed": {
        "node": "board.statusLed"
      },
      "nodes": {
        "routerRelay": {
          "present": true,
          "pins": {
            "out": 0
          }
        }
      }
    },
    "pico2w": {
      "target": "rp2350-arm",
      "board": "pico2w",
      "clock": {
        "tree": "default"
      },
      "statusLed": {
        "node": "board.statusLed"
      },
      "nodes": {
        "routerRelay": {
          "present": true,
          "pins": {
            "out": 0
          }
        }
      }
    },
    "esp32s3-zero": {
      "target": "esp32s3",
      "board": "waveshare-esp32-s3-zero",
      "clock": {
        "tree": "default"
      },
      "statusLed": {
        "node": "board.statusLed",
        "pixelOrder": "GRB"
      },
      "nodes": {
        "routerRelay": {
          "present": true,
          "pins": {
            "out": 1
          }
        }
      }
    }
  }
}
