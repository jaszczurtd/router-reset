{
    "$schema": "../../../JaszczurHAL/vscode/schema/jh_vscode_project.schema.json",
    "project": "router-reset",
    "module": "reseter",
    "toolchain": "cmake",
    "assembly": "picow",
    "buildDir": "${project}/.build",
    "cmakeBuildDir": "${project}/.build/cmake",
    "cmake": {
        "sourceDir": "${jhRoot}/cmake/jh_firmware_project",
        "cache": {
            "JH_PROJECT_DIR": "${project}",
            "JH_MODULE_NAME": "reseter",
            "JH_EXTRA_INCLUDES": "${project}/../../Credentials/src",
            "JH_LINK_LIBRARIES": "${project}/../../Credentials/build/${target}/libCredentials.a"
        }
    },
    "targetProfiles": {
        "rp2350-arm": {
            "upload": {
                "strategy": "serial"
            }
        }
    },
    "identity": {
        "enabled": true,
        "usbManufacturer": "Jaszczur",
        "usbProduct": "Router Reset",
        "byIdHint": "Router_Reset"
    },
    "upload": {
        "strategy": "serial"
    },
    "artifacts": {
        "elf": "${buildDir}/firmware.elf",
        "uf2": "${buildDir}/firmware.uf2"
    }
}
