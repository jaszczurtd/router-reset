{
    "$schema": "../../../libraries/JaszczurHAL/vscode/schema/jh_vscode_project.schema.json",
    "project": "router-reset",
    "module": "reseter",
    "toolchain": "cmake",
    "assembly": "picow",
    "buildDir": "${project}/.build",
    "cmakeBuildDir": "${project}/.build/cmake",
    "cmake": {
        "sourceDir": "${project}/../../libraries/JaszczurHAL/cmake/jh_firmware_project",
        "cache": {
            "JH_PROJECT_DIR": "${project}",
            "JH_MODULE_NAME": "reseter",
            "JH_EXTRA_INCLUDES": "${project}/../../libraries/Credentials/src"
        }
    },
    "targetProfiles": {
        "rp2040": {
            "cmake": {
                "cache": {
                    "JH_LINK_LIBRARIES": "${project}/../../libraries/Credentials/src/cortex-m0plus/libCredentials.a"
                }
            }
        },
        "rp2350-arm": {
            "cmake": {
                "cache": {
                    "JH_LINK_LIBRARIES": "${project}/../../libraries/Credentials/build/rp2350-arm/libCredentials.a"
                }
            },
            "upload": {
                "strategy": "serial"
            }
        },
        "esp32s3": {
            "cmake": {
                "cache": {
                    "JH_LINK_LIBRARIES": "${project}/../../libraries/Credentials/build/esp32s3/libCredentials.a"
                }
            }
        }
    },
    "identity": {
        "enabled": true,
        "usbManufacturer": "Jaszczur",
        "usbProduct": "Router Reset",
        "byIdHint": "Router_Reset"
    },
    "upload": {
        "strategy": "serial"
    },
    "artifacts": {
        "elf": "${buildDir}/firmware.elf",
        "uf2": "${buildDir}/firmware.uf2"
    }
}
