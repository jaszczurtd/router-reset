{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Project: Build",
            "detail": "Compile reseter through JaszczurHAL VS Code entry",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": ["build", "--project", "${workspaceFolder}/reseter"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Build (Debug)",
            "detail": "Debug build reseter through JaszczurHAL VS Code entry",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": ["build-debug", "--project", "${workspaceFolder}/reseter"],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Upload",
            "detail": "Upload through the active target backend",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": ["upload", "--project", "${workspaceFolder}/reseter"],
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Upload (UF2 / BOOTSEL)",
            "detail": "RP2040 only: build and copy UF2 to the single visible BOOTSEL drive",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": ["upload-uf2", "--project", "${workspaceFolder}/reseter"],
            "problemMatcher": []
        },
        {
            "label": "Project: Serial Monitor",
            "detail": "Persistent reseter serial monitor through JaszczurHAL VS Code entry",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": ["monitor", "--project", "${workspaceFolder}/reseter", "--lock-policy", "replace-own"],
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Project: Debug Probe Monitor",
            "detail": "Debug Probe monitor through JaszczurHAL VS Code entry",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": ["monitor-probe", "--project", "${workspaceFolder}/reseter", "--lock-policy", "replace-own"],
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Project: Serial Monitor (Any)",
            "detail": "Any serial monitor through JaszczurHAL VS Code entry",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": ["monitor-any", "--project", "${workspaceFolder}/reseter", "--lock-policy", "wait"],
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Project: Refresh IntelliSense",
            "detail": "Refresh reseter IntelliSense through JaszczurHAL VS Code entry",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": ["refresh-intellisense", "--project", "${workspaceFolder}/reseter"],
            "problemMatcher": []
        },
        {
            "label": "Project: Clean",
            "detail": "Clean reseter build directory through JaszczurHAL VS Code entry",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": ["clean", "--project", "${workspaceFolder}/reseter"],
            "problemMatcher": []
        },
        {
            "label": "Project: Clear USB Identity",
            "detail": "Flash neutral firmware after verifying the current Router Reset identity",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": ["clear-identity", "--project", "${workspaceFolder}/reseter"],
            "problemMatcher": []
        }
    ]
}
